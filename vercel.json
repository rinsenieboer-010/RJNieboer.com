{
  "outputDirectory": ".",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/projects", "destination": "/projects.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|svg|pdf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
